        "id": "logic"
      },
      "outputs": [],
      "source": [
        "# @title 4. Batched Inference Logic\n",
        "BERT_PRE = tf_hub.KerasLayer(\"https://tfhub.dev/tensorflow/bert_en_uncased_preprocess/3\")\n",
        "TXT_CACHE = {}\n",
        "\n",
        "def get_raw_image_feature(image):\n",
        "    image = image.convert('L').resize((224, 224))\n",
        "    img_io = io.BytesIO()\n",
        "    image.save(img_io, format='PNG')\n",
        "    png_bytes = img_io.getvalue()\n",
        "    \n",
        "    example = tf.train.Example()\n",
        "    example.features.feature['image/encoded'].bytes_list.value.append(png_bytes)\n",
        "    example.features.feature['image/format'].bytes_list.value.append(b'png')\n",
        "    \n",
        "    outputs = img_model.signatures[\"serving_default\"](\n",
        "        **{IMG_INPUT_KEY: tf.constant([example.SerializeToString()])}\n",
        "    )\n",
        "    return list(outputs.values())[0]\n",
        "\n",
        "def get_txt_emb(text):\n",
        "    if text in TXT_CACHE: return TXT_CACHE[text]\n",
        "    \n",
        "    out = BERT_PRE(tf.constant([text.lower()]))\n",
        "    ids = out['input_word_ids'].numpy().astype(np.int32)\n",
        "    pads = 1.0 - out['input_mask'].numpy().astype(np.float32)\n",
        "    \n",
        "    ids[ids == 102] = 0\n",
        "    pads[ids == 102] = 1.0\n",
        "    ids_t = tf.constant(np.expand_dims(ids, axis=1))\n",
        "    pads_t = tf.constant(np.expand_dims(pads, axis=1))\n",
        "    \n",
        "    # Dummy image for text-only path\n",
        "    dummy_img = tf.zeros((1, 8, 8, 1376), dtype=tf.float32)\n",
        "    \n",
        "    outputs = txt_model.signatures[\"serving_default\"](\n",
        "        ids=ids_t,\n",
        "        paddings=pads_t,\n",
        "        image_feature=dummy_img\n",
        "    )\n",
        "    \n",
        "    emb = outputs['contrastive_txt_emb'].numpy().flatten()\n",
        "    TXT_CACHE[text] = emb\n",
        "    return emb\n",
        "\n",
        "def get_projected_image_emb(image_feature):\n",
        "    \"\"\"Project image feature into 128-dim space using a dummy text input.\"\"\"\n",
        "    # Dummy text to trigger projection path\n",
        "    dummy_ids = tf.zeros((1, 1, 128), dtype=tf.int32)\n",
        "    dummy_pads = tf.ones((1, 1, 128), dtype=tf.float32)\n",
        "    \n",
        "    outputs = txt_model.signatures[\"serving_default\"](\n",
        "        ids=dummy_ids,\n",
        "        paddings=dummy_pads,\n",
        "        image_feature=image_feature\n",
        "    )\n",
        "    return outputs['contrastive_img_emb'].numpy().flatten()\n",
        "\n",
        "def cos(a, b): \n",
        "    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))\n",
        "\n",
        "def softmax_binary(ps, ns):\n",
        "    exp_p = np.exp(ps)\n",
        "    exp_n = np.exp(ns)\n",
        "    return float(exp_p / (exp_p + exp_n))"
      ]
