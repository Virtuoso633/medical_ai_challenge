        "# @title 3. Load Models\n",
        "import tensorflow as tf\n",
        "import tensorflow_text as tf_text\n",
        "import tensorflow_hub as tf_hub\n",
        "import numpy as np\n",
        "import io\n",
        "import base64\n",
        "from PIL import Image\n",
        "\n",
        "# Confirm GPU status with TensorFlow\n",
        "print(f\"📦 TensorFlow: {tf.__version__}\")\n",
        "print(f\"📦 TensorFlow Text: {tf_text.__version__}\")\n",
        "\n",
        "gpus = tf.config.list_physical_devices('GPU')\n",
        "if gpus:\n",
        "    print(f\"🚀 TensorFlow using GPU: {gpus[0].name}\")\n",
        "else:\n",
        "    print(\"⚠️ TensorFlow running on CPU (slower)\")\n",
        "\n",
        "print(\"\\n📥 Downloading models...\")\n",
        "snapshot_download(\n",
        "    repo_id=\"google/cxr-foundation\",\n",
        "    allow_patterns=[\"elixr-c-v2-pooled/*\", \"pax-elixr-b-text/*\"],\n",
        "    local_dir=\"./cxr_models\"\n",
        ")\n",
        "\n",
        "print(\"🔄 Loading Models...\")\n",
        "img_model = tf.saved_model.load(\"./cxr_models/elixr-c-v2-pooled\")\n",
        "txt_model = tf.saved_model.load(\"./cxr_models/pax-elixr-b-text\")\n",
        "\n",
        "IMG_INPUT_KEY = list(img_model.signatures[\"serving_default\"].structured_input_signature[1].keys())[0]\n",
        "\n",
        "print(\"✅ Models Ready.\")"
      ]
    },
