      "source": [
        "# @title 0. 🖥️ Hardware Check (CPU/GPU Detection)\n",
        "import subprocess\n",
        "import os\n",
        "\n",
        "print(\"=\"*50)\n",
        "print(\"🔍 HARDWARE DETECTION\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "# Check for NVIDIA GPU\n",
        "try:\n",
        "    result = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total,driver_version', '--format=csv,noheader'],\n",
        "                          capture_output=True, text=True, timeout=10)\n",
        "    if result.returncode == 0 and result.stdout.strip():\n",
        "        gpu_info = result.stdout.strip()\n",
        "        gpu_name = gpu_info.split(',')[0].strip()\n",
        "        gpu_memory = gpu_info.split(',')[1].strip() if len(gpu_info.split(',')) > 1 else 'Unknown'\n",
        "        \n",
        "        # Identify specific GPU type\n",
        "        if 'T4' in gpu_name:\n",
        "            gpu_type = '🟢 NVIDIA T4 (Good for inference)'\n",
        "        elif 'A100' in gpu_name:\n",
        "            gpu_type = '🚀 NVIDIA A100 (Premium - Excellent performance!)'\n",
        "        elif 'V100' in gpu_name:\n",
        "            gpu_type = '🔵 NVIDIA V100 (Great performance)'\n",
        "        elif 'L4' in gpu_name:\n",
        "            gpu_type = '🟣 NVIDIA L4 (Good for inference)'\n",
        "        else:\n",
        "            gpu_type = f'🟡 {gpu_name}'\n",
        "        \n",
        "        print(f\"\\n✅ GPU DETECTED!\")\n",
        "        print(f\"   Type: {gpu_type}\")\n",
        "        print(f\"   Full Name: {gpu_name}\")\n",
        "        print(f\"   Memory: {gpu_memory}\")\n",
        "        DEVICE = 'GPU'\n",
        "    else:\n",
        "        raise Exception(\"No GPU found\")\n",
        "except Exception as e:\n",
        "    print(f\"\\n⚠️ NO GPU DETECTED - Running on CPU\")\n",
        "    print(f\"   This will be SLOW for model inference!\")\n",
        "    print(f\"   Tip: Go to Runtime → Change runtime type → GPU\")\n",
        "    DEVICE = 'CPU'\n",
        "\n",
        "# Also check TensorFlow's view\n",
        "print(\"\\n\" + \"-\"*50)\n",
        "print(\"📊 TensorFlow Device Check:\")\n",
        "try:\n",
        "    import tensorflow as tf\n",
        "    print(f\"   TensorFlow version: {tf.__version__}\")\n",
        "    gpus = tf.config.list_physical_devices('GPU')\n",
        "    if gpus:\n",
        "        print(f\"   TensorFlow sees {len(gpus)} GPU(s): {[g.name for g in gpus]}\")\n",
        "    else:\n",
        "        print(\"   TensorFlow sees NO GPUs\")\n",
        "except ImportError:\n",
        "    print(\"   (TensorFlow not yet installed - will check after install)\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)"
      ]
    },
