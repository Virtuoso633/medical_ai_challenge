        "# @title 5. Launch Batch-UI\n",
        "DEFAULT_PROMPTS = {\n",
        "    'No Finding': ('normal chest x-ray', 'pathology findings'),\n",
        "    'Pneumonia': ('pneumonia infection', 'clear lungs'),\n",
        "    'Effusion': ('pleural effusion fluid', 'clear costophrenic angles'),\n",
        "    'Cardiomegaly': ('enlarged heart', 'normal heart size'),\n",
        "    'Atelectasis': ('atelectasis volume loss', 'fully aerated lungs'),\n",
        "    'Consolidation': ('lung consolidation', 'normal translucent lungs')\n",
        "}\n",
        "\n",
        "def run_full(image):\n",
        "    import traceback\n",
        "    try:\n",
        "        if image is None: return \"Upload an image\"\n",
        "        raw_feat = get_raw_image_feature(image)\n",
        "        proj_img = get_projected_image_emb(raw_feat)\n",
        "        \n",
        "        res = []\n",
        "        for k, (v_p, v_n) in DEFAULT_PROMPTS.items():\n",
        "            p_emb = get_txt_emb(v_p)\n",
        "            n_emb = get_txt_emb(v_n)\n",
        "            s = softmax_binary(cos(proj_img, p_emb), cos(proj_img, n_emb))\n",
        "            res.append(f\"{k}: {s*100:.1f}%\")\n",
        "        return \"\\n\".join(res)\n",
        "    except Exception:\n",
        "        return f\"❌ ERROR (V8):\\n{traceback.format_exc()}\"\n",
        "\n",
        "def run_api_batch(b64, prompt_list):\n",
        "    \"\"\"\n",
        "    Args:\n",
        "        b64: Base64 image string\n",
        "        prompt_list: List of dicts [{'pathology': name, 'pos': text, 'neg': text}, ...]\n",
        "    \"\"\"\n",
        "    try:\n",
        "        raw = base64.b64decode(b64)\n",
        "        img = Image.open(io.BytesIO(raw))\n",
        "        raw_feat = get_raw_image_feature(img)\n",
        "        proj_img = get_projected_image_emb(raw_feat)\n",
        "        \n",
        "        results = []\n",
        "        for item in prompt_list:\n",
        "            p_emb = get_txt_emb(item['pos'])\n",
        "            n_emb = get_txt_emb(item['neg'])\n",
        "            s = softmax_binary(cos(proj_img, p_emb), cos(proj_img, n_emb))\n",
        "            results.append({\n",
        "                'pathology': item['pathology'],\n",
        "                'score': s,\n",
        "                'pos': item['pos'],\n",
        "                'neg': item['neg']\n",
        "            })\n",
        "        return results\n",
        "    except Exception as e:\n",
        "        return [str(e)]\n",
        "\n",
        "def run_api_single(b64, pos, neg):\n",
        "    try:\n",
        "        raw = base64.b64decode(b64)\n",
        "        img = Image.open(io.BytesIO(raw))\n",
        "        raw_feat = get_raw_image_feature(img)\n",
        "        proj_img = get_projected_image_emb(raw_feat)\n",
        "        p_emb = get_txt_emb(pos)\n",
        "        n_emb = get_txt_emb(neg)\n",
        "        return softmax_binary(cos(proj_img, p_emb), cos(proj_img, n_emb))\n",
        "    except Exception: return -1.0\n",
        "\n",
        "with gr.Blocks() as demo:\n",
        "    gr.Markdown(\"## CXR Foundation Zero-Shot (V8)\")\n",
        "    with gr.Row():\n",
        "        with gr.Column():\n",
        "            img_in = gr.Image(type=\"pil\")\n",
        "            btn = gr.Button(\"Predict\")\n",
        "        with gr.Column():\n",
        "            out_txt = gr.Textbox(label=\"Results\", lines=10)\n",
        "    btn.click(run_full, inputs=img_in, outputs=out_txt)\n",
        "    \n",
        "    # Standard API\n",
        "    api_b64 = gr.Textbox(visible=False)\n",
        "    api_pos = gr.Textbox(visible=False)\n",
        "    api_neg = gr.Textbox(visible=False)\n",
        "    api_out = gr.Number(visible=False)\n",
        "    api_btn = gr.Button(visible=False)\n",
        "    api_btn.click(run_api_single, inputs=[api_b64, api_pos, api_neg], outputs=api_out, api_name=\"predict\")\n",
        "    \n",
        "    # Batch API\n",
        "    batch_prompts = gr.JSON(visible=False)\n",
        "    batch_out = gr.JSON(visible=False)\n",
        "    batch_btn = gr.Button(visible=False)\n",
        "    batch_btn.click(run_api_batch, inputs=[api_b64, batch_prompts], outputs=batch_out, api_name=\"predict_batch\")\n",
        "\n",
        "demo.queue().launch(share=True, debug=True, inline=False)"
